{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "bash": {
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git branch -D*": "ask",
      "git rebase*": "ask",
      "supabase db reset*": "ask",
      "supabase db drop*": "ask"
    }
  },
  "mcp": {
    "fba-manager": {
      "type": "remote",
      "url": "https://amazon-fba-manager-virid.vercel.app/api/mcp"
    }
  }
}
