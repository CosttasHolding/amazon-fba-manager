NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron jobs (Vercel Cron + n8n)
CRON_SECRET=your-cron-secret-here
AUTOMATION_SECRET=your-automation-secret-here

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=notifications@yourdomain.com

# SP-API (Amazon Seller)
SP_API_CLIENT_ID=your_client_id
SP_API_CLIENT_SECRET=your_client_secret
SP_API_REFRESH_TOKEN=your_refresh_token

# VAPID (Web Push Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@domain.com

# Google Drive (OAuth2)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# Optional allowlist: comma-separated active organization IDs
GOOGLE_DRIVE_SHARED_ORG_IDS=
# JSON mapping of organization UUIDs to dedicated Google Drive root folder IDs
GOOGLE_DRIVE_ROOT_FOLDER_IDS={"00000000-0000-4000-8000-000000000000":"drive-folder-id"}
# Explicit callback URL registered in Google Cloud OAuth credentials
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.example.com/api/drive/auth/callback
# Base64-encoded 32-byte AES-GCM key; server-only, never commit a real value
DRIVE_TOKEN_ENCRYPTION_KEY=base64_32_byte_key

# QA Drive CRUD (only local or explicitly allowlisted non-production hosts)
QA_DRIVE_CRUD_ALLOW=
QA_DRIVE_ALLOWED_HOSTS=

# AI (xAI / Grok) — deep dive y análisis de productos
XAI_API_KEY=your_xai_key_here
